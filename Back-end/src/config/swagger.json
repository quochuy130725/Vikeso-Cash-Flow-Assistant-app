{
  "openapi": "3.0.0",
  "info": {
    "title": "Vikeso API Documentation",
    "version": "1.0.0",
    "description": "Tài liệu API cho dự án Vikeso - Trợ lý Kế toán AI cho Hộ kinh doanh"
  },
  "servers": [
    {
      "url": "https://vikeso-cash-flow-assistant-app.onrender.com",
      "description": "Production server (Render)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Đăng ký tài khoản mới",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "name": { "type": "string" },
                  "shopName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Đăng ký thành công" },
          "400": { "description": "Lỗi dữ liệu đầu vào" },
          "409": { "description": "Email đã tồn tại" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Đăng nhập bằng Email/Password",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Đăng nhập thành công" },
          "401": { "description": "Sai email hoặc mật khẩu" }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Đăng nhập bằng Google",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Thành công" }
        }
      }
    },
    "/api/scan-receipt": {
      "post": {
        "summary": "Scan hóa đơn bằng AI (Gemini)",
        "tags": ["Transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Kết quả bóc tách JSON từ AI" }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "summary": "Lấy danh sách giao dịch của User",
        "tags": ["Transactions"],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Danh sách giao dịch" }
        }
      }
    }
  }
}
