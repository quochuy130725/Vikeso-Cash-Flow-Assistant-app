{
  "openapi": "3.0.0",
  "info": {
    "title": "Vikeso API Documentation",
    "version": "1.0.0",
    "description": "Tài liệu API cho dự án Vikeso - Trợ lý Kế toán AI cho Hộ kinh doanh"
  },
  "servers": [
    {
      "url": "https://vikeso-cash-flow-assistant-app.onrender.com",
      "description": "Production server (Render)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Đăng ký tài khoản mới",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "shopName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công"
          },
          "400": {
            "description": "Lỗi dữ liệu đầu vào"
          },
          "409": {
            "description": "Email đã tồn tại"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Đăng nhập bằng Email/Password",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công"
          },
          "401": {
            "description": "Sai email hoặc mật khẩu"
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Đăng nhập bằng Google",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công"
          }
        }
      }
    },
    "/api/scan-receipt": {
      "post": {
        "summary": "Scan hóa đơn bằng AI (Gemini)",
        "tags": [
          "Transactions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả bóc tách JSON từ AI"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "summary": "Lấy danh sách giao dịch của User",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách giao dịch"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Lấy thông tin user hiện tại",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công"
          },
          "401": {
            "description": "Chưa xác thực"
          }
        }
      }
    },
    "/api/auth/profile": {
      "put": {
        "summary": "Cập nhật thông tin cá nhân",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shopName": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "avatar": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công"
          },
          "401": {
            "description": "Chưa xác thực"
          }
        }
      }
    },
    "/api/telegram/webhook": {
      "post": {
        "summary": "Nhận update từ Telegram Bot (Telegram tự gọi)",
        "description": "Endpoint này được Telegram gọi tự động khi user gửi tin nhắn /start đến bot. Không cần gọi thủ công.",
        "tags": [
          "Telegram"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "object",
                    "properties": {
                      "chat": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          }
                        }
                      },
                      "text": {
                        "type": "string",
                        "example": "/start 64abc123..."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (luôn trả 200 để Telegram không gửi lại)"
          }
        }
      }
    },
    "/api/telegram/set-webhook": {
      "get": {
        "summary": "Đăng ký Webhook URL với Telegram Bot (gọi 1 lần)",
        "description": "Gọi endpoint này 1 lần duy nhất sau khi deploy để Telegram biết gửi update về đâu. Không cần auth.",
        "tags": [
          "Telegram"
        ],
        "responses": {
          "200": {
            "description": "Webhook đã được đăng ký thành công"
          },
          "500": {
            "description": "Lỗi đăng ký"
          }
        }
      }
    },
    "/api/test-report": {
      "post": {
        "summary": "Kích hoạt gửi báo cáo cuối ngày ngay lập tức (Test / Thủ công)",
        "description": "Chạy thủ công luồng tổng hợp doanh thu trong ngày và tự động gửi thông báo qua Email & Telegram cho các shop có phát sinh giao dịch mà không cần chờ đến 22:00.",
        "tags": [
          "Reports"
        ],
        "responses": {
          "200": {
            "description": "Báo cáo đã được gửi thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Báo cáo đã được gửi thành công!" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "totalUsers": { "type": "integer", "example": 2 },
                        "emailSent": { "type": "integer", "example": 2 },
                        "telegramSent": { "type": "integer", "example": 1 },
                        "skipped": { "type": "integer", "example": 0 },
                        "errors": { "type": "array", "items": { "type": "object" } }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Lỗi máy chủ khi xử lý báo cáo"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}