{
  "openapi": "3.0.0",
  "info": {
    "title": "Vikeso API Documentation",
    "version": "1.0.0",
    "description": "Tài liệu API cho dự án Vikeso - Trợ lý Kế toán AI cho Hộ kinh doanh"
  },
  "servers": [
    {
      "url": "https://vikeso-cash-flow-assistant-app.onrender.com",
      "description": "Production server (Render)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Đăng ký tài khoản mới",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  },
                  "name": {
                    "type": "string",
                    "example": "Nguyễn Văn A"
                  },
                  "shopName": {
                    "type": "string",
                    "example": "Tiệm Cà Phê Vikeso"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công"
          },
          "400": {
            "description": "Lỗi dữ liệu đầu vào"
          },
          "409": {
            "description": "Email đã tồn tại"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Đăng nhập bằng Email/Password",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công"
          },
          "401": {
            "description": "Sai email hoặc mật khẩu"
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Đăng nhập bằng Google",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idToken"],
                "properties": {
                  "idToken": {
                    "type": "string",
                    "description": "Google ID Token lấy từ Google Sign-In SDK"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công"
          },
          "401": {
            "description": "Token không hợp lệ"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Lấy thông tin user hiện tại",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công"
          },
          "401": {
            "description": "Chưa xác thực"
          }
        }
      }
    },
    "/api/auth/profile": {
      "put": {
        "summary": "Cập nhật thông tin cá nhân",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shopName": {
                    "type": "string",
                    "example": "Cửa Hàng Mới"
                  },
                  "phone": {
                    "type": "string",
                    "example": "0987654321"
                  },
                  "avatar": {
                    "type": "string",
                    "example": "https://example.com/avatar.jpg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công"
          },
          "401": {
            "description": "Chưa xác thực"
          }
        }
      }
    },
    "/api/scan-receipt": {
      "post": {
        "summary": "Scan hóa đơn bằng AI (Gemini OCR)",
        "description": "Upload ảnh hóa đơn/chứng từ để Gemini AI nhận diện loại giao dịch (THU/CHI), số tiền, ngày và danh mục.",
        "tags": [
          "Transactions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "File ảnh chụp hóa đơn (JPG, PNG, WebP)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả bóc tách JSON từ AI"
          },
          "400": {
            "description": "Lỗi file upload hoặc định dạng không hợp lệ"
          }
        }
      }
    },
    "/api/confirm-receipt": {
      "post": {
        "summary": "Xác nhận & Lưu hóa đơn (Sau khi AI Scan & SplitScreen)",
        "description": "Lưu các giao dịch vào MongoDB sau khi người dùng review trên màn hình SplitScreen. Tự động broadcast WebSocket `new_transaction` để cập nhật realtime.",
        "tags": [
          "Transactions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId", "items"],
                "properties": {
                  "userId": {
                    "type": "string",
                    "example": "6ac3f34375392ac160b8c0d9"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "category": { "type": "string", "example": "Hoa Don Le" },
                        "transactionType": { "type": "string", "enum": ["THU", "CHI"], "example": "THU" },
                        "totalAmount": { "type": "number", "example": 150000 },
                        "reason": { "type": "string", "example": "Bán 3 ly cà phê muối" },
                        "confidenceLevel": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"], "example": "HIGH" },
                        "transactionDate": { "type": "string", "format": "date-time" },
                        "aiRawData": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã lưu hóa đơn thành công và phát WebSocket"
          },
          "400": {
            "description": "Thiếu dữ liệu bắt buộc"
          }
        }
      }
    },
    "/api/manual-entry": {
      "post": {
        "summary": "Nhập giao dịch thủ công (Lưới lọc thông minh 2 chiều)",
        "description": "Lưu giao dịch nhập tay. Tự động áp dụng lưới lọc 2 chiều (Bidirectional Smart Filter) để tự động MERGE khi xuất hiện POS Kết Ca.",
        "tags": [
          "Transactions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "example": "6ac3f34375392ac160b8c0d9"
                  },
                  "category": {
                    "type": "string",
                    "enum": ["Hoa Don Le", "POS Ket Ca", "So Tay", "Chuyen Khoan", "Khac"],
                    "example": "So Tay"
                  },
                  "transactionType": {
                    "type": "string",
                    "enum": ["THU", "CHI"],
                    "example": "CHI"
                  },
                  "totalAmount": {
                    "type": "number",
                    "example": 50000
                  },
                  "reason": {
                    "type": "string",
                    "example": "Mua đá lạnh"
                  },
                  "transactionDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "items": {
                    "type": "array",
                    "description": "Có thể truyền mảng items thay vì 1 object đơn lẻ",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lưu giao dịch thành công"
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "summary": "Lấy danh sách giao dịch của User",
        "tags": [
          "Transactions"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "MongoDB _id của người dùng"
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách giao dịch hợp lệ"
          },
          "400": {
            "description": "Thiếu userId"
          }
        }
      }
    },
    "/api/user/{id}/profile": {
      "get": {
        "summary": "Lấy thông tin profile & trạng thái cài đặt thông báo",
        "description": "Kiểm tra xem user đã liên kết Telegram chưa (`hasTelegram`) và cài đặt nhận thông báo hiện tại.",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "MongoDB _id của người dùng"
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "hasTelegram": { "type": "boolean", "example": true },
                    "settings": {
                      "type": "object",
                      "properties": {
                        "receiveEmail": { "type": "boolean", "example": true },
                        "receiveTelegram": { "type": "boolean", "example": true },
                        "receiveInApp": { "type": "boolean", "example": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy user"
          }
        }
      }
    },
    "/api/user/{id}/notification-settings": {
      "put": {
        "summary": "Cập nhật cài đặt nhận thông báo",
        "description": "Bật/tắt nhận báo cáo qua Email, Telegram Bot, hoặc In-App notification.",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "MongoDB _id của người dùng"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receiveEmail": { "type": "boolean", "example": true },
                  "receiveTelegram": { "type": "boolean", "example": true },
                  "receiveInApp": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công"
          },
          "404": {
            "description": "Không tìm thấy user"
          }
        }
      }
    },
    "/api/telegram/webhook": {
      "post": {
        "summary": "Nhận update từ Telegram Bot (Telegram Webhook)",
        "description": "Endpoint này được máy chủ Telegram gọi tự động khi người dùng nhắn tin hoặc bấm Start. Hỗ trợ liên kết tài khoản qua: (1) `/start <userId>`, (2) `/start <email>`, hoặc (3) Người dùng nhắn trực tiếp Email tài khoản vào bot.",
        "tags": [
          "Telegram"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "object",
                    "properties": {
                      "chat": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer", "example": 123456789 }
                        }
                      },
                      "text": {
                        "type": "string",
                        "example": "qhuy8452@gmail.com"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (luôn trả 200 để Telegram xác nhận đã nhận tin)"
          }
        }
      }
    },
    "/api/telegram/set-webhook": {
      "get": {
        "summary": "Đăng ký Webhook URL với Telegram Bot",
        "description": "Gọi endpoint này 1 lần duy nhất sau khi deploy để Telegram biết URL webhook gửi update về.",
        "tags": [
          "Telegram"
        ],
        "responses": {
          "200": {
            "description": "Webhook đã được đăng ký thành công"
          },
          "500": {
            "description": "Lỗi đăng ký"
          }
        }
      }
    },
    "/api/test-report": {
      "post": {
        "summary": "Kích hoạt gửi báo cáo cuối ngày ngay lập tức (Test / Thủ công)",
        "description": "Chạy thủ công luồng tổng hợp tài chính trong ngày và gửi Email & Telegram. Hỗ trợ cờ `sendZeroReports` để gửi báo cáo kiểm tra ngay cả khi chưa phát sinh hóa đơn nào trong ngày.",
        "tags": [
          "Reports"
        ],        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sendZeroReports": {
                    "type": "boolean",
                    "default": true,
                    "description": "Nếu true: Gửi cho tất cả tài khoản đã bật thông báo kể cả khi hôm nay có 0 giao dịch. Nếu false: Chỉ gửi cho tài khoản có giao dịch."
                  },
                  "email": {
                    "type": "string",
                    "example": "chuvua.bacuong@gmail.com",
                    "description": "Chỉ định gửi test cho 1 email cụ thể. Nếu để trống sẽ gửi cho tất cả người dùng hợp lệ."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Báo cáo đã được gửi thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Báo cáo đã được gửi thành công!" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "totalUsers": { "type": "integer", "example": 5 },
                        "emailSent": { "type": "integer", "example": 5 },
                        "telegramSent": { "type": "integer", "example": 1 },
                        "skipped": { "type": "integer", "example": 0 },
                        "errors": { "type": "array", "items": { "type": "object" } }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Lỗi máy chủ khi xử lý báo cáo"
          }
        }
      }
    },
    "/api/billing/create-order": {
      "post": {
        "summary": "Tạo đơn nâng cấp PRO + VietQR SePay",
        "tags": ["Billing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId"],
                "properties": { "userId": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "201": { "description": "Tạo order thành công" } }
      }
    },
    "/api/billing/status/{orderCode}": {
      "get": {
        "summary": "Poll trạng thái đơn PRO",
        "tags": ["Billing"],
        "parameters": [
          { "name": "orderCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "PENDING | SUCCESS | FAILED | EXPIRED" } }
      }
    },
    "/api/billing/history": {
      "get": {
        "summary": "Lịch sử đơn PRO của user",
        "tags": ["Billing"],
        "parameters": [
          { "name": "userId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Danh sách orders" } }
      }
    },
    "/api/billing/sepay/webhook": {
      "post": {
        "summary": "SePay webhook (SePay gọi)",
        "description": "Header x-api-key phải trùng SEPAY_WEBHOOK_API_KEY. Luôn trả 200 {success:true}.",
        "tags": ["Billing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer", "example": 92704 },
                  "gateway": { "type": "string", "example": "Vietcombank" },
                  "transferType": { "type": "string", "example": "in" },
                  "transferAmount": { "type": "integer", "example": 99000 },
                  "content": { "type": "string", "example": "VIKESO ABC123 chuyen tien" },
                  "code": { "type": "string", "example": null }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "{success:true}" } }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "Admin: danh sách user + tổng thu/chi",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "plan", "in": "query", "schema": { "type": "string", "enum": ["FREE", "PRO"] } },
          { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["OWNER", "ADMIN"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Danh sách user" }, "403": { "description": "Không phải ADMIN" } }
      }
    },
    "/api/admin/users/{id}": {
      "get": {
        "summary": "Admin: chi tiết 1 user",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "User + stats + receipts/orders gần nhất" } }
      },
      "delete": {
        "summary": "Admin: xóa user + receipts + orders",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Đã xóa" } }
      }
    },
    "/api/admin/users/{id}/plan": {
      "patch": {
        "summary": "Admin: đổi gói FREE/PRO",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "plan": { "type": "string", "enum": ["FREE", "PRO"] }, "extendDays": { "type": "integer", "default": 30 } } } } } },
        "responses": { "200": { "description": "Đã cập nhật plan" } }
      }
    },
    "/api/admin/users/{id}/role": {
      "patch": {
        "summary": "Admin: đổi role OWNER/ADMIN",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "role": { "type": "string", "enum": ["OWNER", "ADMIN"] } } } } } },
        "responses": { "200": { "description": "Đã cập nhật role" } }
      }
    },
    "/api/admin/overview": {
      "get": {
        "summary": "Admin: tổng quan hệ thống (users, MRR, thu/chi hôm nay + tháng)",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Tổng quan" } }
      }
    },
    "/api/admin/transactions": {
      "get": {
        "summary": "Admin: tất cả giao dịch thu/chi",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["THU", "CHI"] } },
          { "name": "from", "in": "query", "schema": { "type": "string" } },
          { "name": "to", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Danh sách giao dịch" } }
      }
    },
    "/api/admin/payments": {
      "get": {
        "summary": "Admin: doanh thu subscriptions SePay",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
